__pycache__/
# A directory from npm, or the dev shell's link into the Nix store.
mod/node_modules
# The engine's types for the mod, which it writes on loading it; see
# mod/README.md for laying them by hand.
mod/.claude-plugin/types/
*.pyc
.DS_Store

# Failure dumps written by the golden suites: the two sides of every
# disagreement, so diff shows it directly.  Rewritten on every run.
tests/out/
tests/out-cost/
tests/out-subagent/

# The alignment probe is switched on by this file being present.
tools/align-probe/align-probe.on

# Nix: build outputs, and the dev shell's state.
result
result-*
.direnv/

# Project-scope skill installs from the dev shell's reconcile startup hook.
# Symlinks into the Nix store, not source.
/.claude/skills/
