// Every option either port takes: the Python's flags, and the settings a
// configuration file may give either port (agents/plans/config-merge.md).
//
// tools/gen-spec.py writes this out as coding_agent_usage_line/
// options_spec.py and as mod/src/options_spec.ts, as it writes
// spec/layout.jsonc, and writes the option tables of docs/options.md
// between their `<!-- options:begin NAME -->` and `<!-- options:end NAME -->`
// markers.  Edit here, never there, and run `python3 tools/gen-spec.py`;
// tests/formatting.py fails while any of them is out of date.
//
// An option's name is its long flag without the `--`, and the key a file
// sets it by.  Each record has, in this order:
//
//   type        "bool", "int", "string", "enum", "list" or "table"
//   items       an enum's values
//   fields      a table's fields, each {type, items, fixed}; `fixed` names
//               the rows a file cannot move from the default's value
//   rows        a table's rows, by name
//   metavar     the flag's value as the docs write it; an enum without one
//               is written as its items, `day|week|month`
//   default     the built-in value of an option no file sets ("file":
//               false); null for none.  An option a file may set has its
//               default in mod/defaults/config.jsonc and nowhere else,
//               which both ports read at every run (config-merge.md,
//               Decided 18); tools/gen-spec.py holds that file to this one
//   derived     {from, map}: the value worked out from another option's
//               when no layer sets this one, the map keyed by that
//               option's value as a string and naming every value it can
//               take; its default in mod/defaults/config.jsonc is null
//   minimum     an int's least value
//   ports       which ports read it: "py", "mod" or both
//   agents      the agents whose command line takes the flag; left out,
//               every agent's
//   file        whether a configuration file may set it: false for what
//               describes one run, not a preference
//   flag        the flag, or null for none
//   aliases     other spellings of the flag
//   negatable   a bool's flag is written both ways, `--x` and `--no-x`
//   modes       the modes the docs say it applies in
//   doc-table   the table of docs/options.md it is a row of, or null
//   doc-default the Default cell, where the default alone does not say it
//   usage       a flag's line in `--help`: plain ASCII, short, saying what
//               the spelling the doc table shows does.  cli.py writes it
//               under the flag's spellings, with the modes it applies in
//   doc         the Effect cell: what the flag the table shows does (the
//               `--no-` one, for a bool that defaults to true).  Markdown,
//               written as lines that are joined with one space
//
// The mod's timings (tick, clock, receipt, fold-save and slow-read times)
// and its caches' version stay constants in mod/hooks/config.ts, out of
// this table (config-merge.md, Decided 5).
{
  "OPTIONS": {
    // ── Shared options ───────────────────────────────────────────────────
    "agent": {
      "type": "enum",
      "items": ["claude", "codex"],
      "default": null,
      "ports": ["py"],
      "file": false,
      "flag": "--agent",
      "doc-table": "shared",
      "doc-default": "—",
      "usage": "Required, except with --help and --selftest.",
      "doc": ["Which transcript format and hook conventions to use.",
              "Required."]
    },
    "mode": {
      "type": "enum",
      "items": ["status", "cost", "subagent"],
      "metavar": "MODE",
      "default": "status",
      "ports": ["py"],
      "file": false,
      "flag": "--mode",
      "doc-table": "shared",
      "usage": "status (the default), cost or subagent; see Modes.",
      "doc": ["See [Modes](#modes)."]
    },
    "transcript": {
      "type": "string",
      "metavar": "PATH",
      "default": null,
      "ports": ["py"],
      "file": false,
      "flag": "--transcript",
      "doc-table": "shared",
      "doc-default": "the payload's path",
      "usage": "Read one transcript; never waits for stdin.",
      "doc": ["Read this transcript instead of the one the payload names,",
              "and don't read stdin. For offline use: it skips the Stop",
              "hook's wait for the transcript to finish writing, and never",
              "records \"already reported\" state, so it can't change what",
              "the live hook reports next."]
    },
    "usage-source": {
      "type": "string",
      "metavar": "SPEC",
      "ports": ["py", "mod"],
      "file": true,
      "flag": "--usage-source",
      "doc-table": "shared",
      "usage": ["auto, native, none/off, claude-usage-tracker,",
                "codex-app-server, anthropic-admin, openai-admin,",
                "experimental-claude-oauth, experimental-codex-api, or",
                "cmd:PATH."],
      "doc": ["Where plan/quota figures come from. See",
              "[Usage sources](usage-sources.md)."]
    },
    "account": {
      "type": "string",
      "metavar": "NAME",
      "ports": ["py", "mod"],
      "file": true,
      "flag": "--account",
      "doc-table": "shared",
      "usage": "Non-secret account cache namespace.",
      "doc": ["A non-secret label that keeps cached readings for different",
              "accounts apart. Never put a token here."]
    },
    "account-period": {
      "type": "enum",
      "items": ["day", "week", "month"],
      "ports": ["py", "mod"],
      "file": true,
      "flag": "--account-period",
      "doc-table": "shared",
      "usage": "The organization reports' UTC period.",
      "doc": ["The UTC calendar period for organization reports",
              "(`anthropic-admin`, `openai-admin`). Weeks start on Monday."]
    },
    "all": {
      "type": "bool",
      "default": false,
      "ports": ["py"],
      "file": false,
      "flag": "--all",
      "doc-table": "shared",
      "usage": "Plain cost history without consuming Stop state.",
      "doc": ["With `--mode cost`: list every prompt as plain text instead",
              "of emitting a hook response. Codex also lists completed",
              "child agents. Doesn't consume Stop-hook state."]
    },
    "from-figures": {
      "type": "string",
      "metavar": "PATH",
      "default": null,
      "ports": ["py"],
      "file": false,
      "flag": "--from-figures",
      "doc-table": "shared",
      "usage": ["Claude: draw a figures document (tests/README.md,",
                "\"Figures\") instead of reading any input."],
      "doc": ["Claude: draw a saved figures document instead of reading",
              "any input. The test suite saves one per case; useful for",
              "redrawing a captured layout. See",
              "[the tests' README](../tests/README.md#figures)."]
    },
    "diagnose": {
      "type": "bool",
      "default": false,
      "ports": ["py"],
      "file": false,
      "flag": "--diagnose",
      "doc-table": "shared",
      "usage": "Redacted source/coverage diagnostics on stderr.",
      "doc": ["Write one redacted line to stderr: which source was used,",
              "whether a reading was available, whether it is stale, and",
              "when a failed source will be retried. Claude's status line",
              "adds the session's cost and lines two ways, as a check on",
              "each other: `cost_usd` and `lines`, this program's own over",
              "the transcript and the agent files, as the cost line totals",
              "them, and `claude_cost_usd` and `claude_lines`, the totals",
              "Claude Code's payload gave; each is blank where its side has",
              "none. Codex adds child-rollout coverage. Never prints",
              "credentials, command paths or raw responses."]
    },
    // The terminal's width is never a preference, so no file sets it.
    "cols": {
      "type": "int",
      "metavar": "N",
      "default": null,
      "minimum": 0,
      "ports": ["py"],
      "file": false,
      "flag": "--cols",
      "doc-table": "shared",
      "doc-default": "detected",
      "usage": "Non-negative terminal width (0 means unknown width).",
      "doc": ["Terminal width. `0` means \"unknown\", which forces the",
              "fallback layout. Claude only; Codex accepts and ignores it."]
    },
    // The panel's rows end where the band's do: 2 short of the edge with
    // the mod's rows under the footer line, 5 with them above the prompt.
    // Unset in every layer, it follows live-place, in both ports.
    "right-edge": {
      "type": "int",
      "metavar": "N",
      "derived": {"from": "live-place", "map": {"footer": 2, "above": 5}},
      "minimum": 0,
      "ports": ["py", "mod"],
      "file": true,
      "flag": "--right-edge",
      "doc-table": "shared",
      "doc-default": "`2` under `live-place` `footer`, `5` under `above`",
      "usage": ["Columns every agent-panel row leaves blank at the",
                "terminal's right edge (default: 2 with the mod's rows",
                "under the footer line; 5, the band's [-] room, with",
                "them above the prompt)."],
      "doc": ["The columns every agent-panel row leaves blank at the",
              "terminal's right edge. `2` matches the mod with its rows",
              "under the footer line, whose container stops two columns",
              "short of the edge; `5` is the room Claude Code keeps for the",
              "mod's band `[-]` above the prompt. Unset, it follows the",
              "mod's `live-place` from the files, so the panel and the band",
              "end in one column; a panel run without the mod sets it",
              "where it wants another. Claude only."]
    },
    // One list for the band and the panel.  The rows table, not hide,
    // drops a whole row (config-merge.md, Decided 9).
    "hide": {
      "type": "list",
      "metavar": "PATH",
      "ports": ["py", "mod"],
      "file": true,
      "flag": "--hide",
      "doc-table": "shared",
      "usage": ["Repeatable. Leave out a column or a label part,",
                "scope[.group[.metric]] with * for any one part",
                "(docs/options.md). The agent panel only, for now; the",
                "other modes accept it and ignore it."],
      "doc": ["Repeatable. Leave a column or a part of a row's label out of",
              "the redesigned grid; see [Hiding](#hiding). Only the agent",
              "panel draws on the grid so far; the other modes, and Codex,",
              "accept it and ignore it."]
    },

    // ── Claude display options ───────────────────────────────────────────
    "column-rules": {
      "type": "bool",
      "ports": ["py"],
      "agents": ["claude"],
      "file": true,
      "flag": "--column-rules",
      "negatable": true,
      "modes": ["status"],
      "doc-table": "display",
      "usage": "Draw faint | rules between the columns.",
      "doc": ["Draw faint `|` rules between the columns. Nothing moves."]
    },
    "mark-spacing": {
      "type": "bool",
      "ports": ["py", "mod"],
      "agents": ["claude"],
      "file": true,
      "flag": "--mark-spacing",
      "negatable": true,
      "modes": ["status", "cost", "subagent"],
      "doc-table": "display",
      "usage": "Close the blank between a mark and its value.",
      "doc": ["Close the blank between a mark and its value."]
    },
    "subscript-decimals": {
      "type": "bool",
      "ports": ["py", "mod"],
      "agents": ["claude"],
      "file": true,
      "flag": "--subscript-decimals",
      "negatable": true,
      "modes": ["status", "cost", "subagent"],
      "doc-table": "display",
      "usage": "Write the digits after a decimal point as subscripts.",
      "doc": ["Write fractions as subscript digits: `1.2٪` becomes `1₂٪`."]
    },
    "color": {
      "type": "bool",
      "ports": ["py"],
      "agents": ["claude"],
      "file": true,
      "flag": "--color",
      "modes": ["cost"],
      "doc-table": "display",
      "usage": "Colour the rows.",
      "doc": ["Colour the rows. The Stop hook's message is shown as plain",
              "text, so leave it off there."]
    },
    "totals": {
      "type": "bool",
      "ports": ["py"],
      "agents": ["claude"],
      "file": true,
      "flag": "--totals",
      "negatable": true,
      "modes": ["cost"],
      "doc-table": "display",
      "usage": "Drop the session-totals row.",
      "doc": ["Drop the 🎮 session-totals row."]
    },
    "right-align": {
      "type": "bool",
      "ports": ["py"],
      "agents": ["claude"],
      "file": true,
      "flag": "--right-align",
      "negatable": true,
      "modes": ["cost"],
      "doc-table": "display",
      "usage": "Print the rows flush left.",
      "doc": ["Print the rows flush left."]
    },
    "account-totals": {
      "type": "bool",
      "ports": ["py"],
      "agents": ["claude"],
      "file": true,
      "flag": "--account-totals",
      "negatable": true,
      "modes": ["cost"],
      "doc-table": "display",
      "usage": "Drop the account half of each battery cell.",
      "doc": ["Drop the second half of each 🔋 and 🪫 cell: `💳 41٪` on the",
              "totals row, `📖`/`📝` on the prompt row."]
    },
    "datetime": {
      "type": "bool",
      "ports": ["py"],
      "agents": ["claude"],
      "file": true,
      "flag": "--datetime",
      "negatable": true,
      "modes": ["cost"],
      "doc-table": "display",
      "usage": "Drop the date and time cells.",
      "doc": ["Drop the 📅 date and 🕐 time cells."]
    },
    "usage-text": {
      "type": "bool",
      "ports": ["py"],
      "agents": ["claude"],
      "file": true,
      "flag": "--usage-text",
      "negatable": true,
      "modes": ["cost"],
      "doc-table": "display",
      "usage": "Drop the \"Usage: ...\" words from the row labels.",
      "doc": ["Drop the `Usage: …` words from the row labels, keeping each",
              "row's glyph."]
    },
    "force-newline": {
      "type": "bool",
      "ports": ["py"],
      "agents": ["claude"],
      "file": true,
      "flag": "--force-newline",
      "modes": ["cost"],
      "doc-table": "display",
      "usage": "Always start the message with a blank line.",
      "doc": ["Always start the message with a blank line."]
    },
    "prefix": {
      "type": "string",
      "metavar": "TEXT",
      "ports": ["py"],
      "file": true,
      "flag": "--prefix",
      "modes": ["cost"],
      "doc-table": "display",
      "usage": "The mark at the start of each row.",
      "doc": ["The mark at the start of each row."]
    },
    "label": {
      "type": "string",
      "metavar": "TEXT",
      // The words padded to the widest row label's ("Usage: Session
      // (total)"), as formatting.C_LABEL is, so the rows' labels end in one
      // column.
      "derived": {"from": "usage-text",
                  "map": {"true": "🎤 Usage: Prompt (last)  ", "false": "🎤"}},
      "ports": ["py"],
      "file": true,
      "flag": "--label",
      "modes": ["cost"],
      "doc-table": "display",
      "usage": "The label of the prompt row.",
      "doc": ["The label of the prompt row. Default",
              "`🎤 Usage: Prompt (last)`, or `🎤` with `--no-usage-text`."]
    },

    // ── One run's, never a file's ────────────────────────────────────────
    "selftest": {
      "type": "bool",
      "default": false,
      "ports": ["py"],
      "file": false,
      "flag": "--selftest",
      "doc-table": null,
      "usage": "Draw specimen rows and report where the cursor landed.",
      "doc": ["Draw specimen rows on the terminal and report where the",
              "cursor landed."]
    },
    "help": {
      "type": "bool",
      "default": false,
      "ports": ["py"],
      "file": false,
      "flag": "--help",
      "aliases": ["-h"],
      "doc-table": null,
      "usage": "Print this usage and exit.",
      "doc": ["Print the usage and exit."]
    },
    "show-config": {
      "type": "bool",
      "default": false,
      "ports": ["py"],
      "file": false,
      "flag": "--show-config",
      "doc-table": null,
      "usage": ["Print the merged options, each with the layer and file",
                "it came from, and exit."],
      "doc": ["Print the merged options, each with the layer it came from",
              "and that layer's file, and any warning the files gave, and",
              "exit. See [Configuration files](#configuration-files)."]
    },

    // ── The mod's, set in files only ─────────────────────────────────────
    // Where the mod draws its live rows: under Claude Code's footer line
    // (`-- INSERT -- ⏵⏵ auto mode on …`), or above the prompt, where the
    // band can be collapsed with its [-] and scrolled.
    "live-place": {
      "type": "enum",
      "items": ["footer", "above"],
      "ports": ["mod"],
      "file": true,
      "flag": null,
      "doc-table": null,
      "doc": ["Where the mod draws its live rows: under Claude Code's",
              "footer line, or above the prompt."]
    },
    // Each row the mod can draw, by when the mod draws it and whether a
    // turn's end stamps it into the transcript (config-merge.md, "The rows
    // table").  Tables merge per field across layers.
    "rows": {
      "type": "table",
      "fields": {
        //   "never"   — the mod never draws it
        //   "running" — drawn while a turn runs, gone at its end
        //   "always"  — drawn while a turn runs, and kept after
        "live": {"type": "enum", "items": ["never", "running", "always"]},
        // Stamped into the transcript when the turn ends.
        // `fixed`: the rows whose value is the default's, whatever a
        // file says; a file that sets another is warned about (Decided 16).
        "transcript": {"type": "bool", "fixed": ["account"]}
      },
      // 🎤 turn, 🤖 agent, 🎮 session, the 🔻🔖 line under the prompt and
      // the receipt's 🔺🔖 line, and the 💳 account row.
      "rows": ["turn", "agent", "session", "tag", "account"],
      "ports": ["mod"],
      "file": true,
      "flag": null,
      "doc-table": null,
      "doc": ["Each row the mod draws, 🎤 `turn`, 🤖 `agent`, 🎮 `session`,",
              "the 🔖 `tag` lines and the 💳 `account` row: `live`, whether",
              "it is drawn `never`, while a turn is `running` or `always`,",
              "and `transcript`, whether a turn's end stamps it into the",
              "transcript."]
    },
    "account-place": {
      "type": "enum",
      "items": ["row", "tail"],
      "ports": ["mod"],
      "file": true,
      "flag": null,
      "doc-table": null,
      "doc": ["Where the 💳 account is drawn when `rows.account.live` draws",
              "it: `row`, a row of its own under Claude Code's footer line,",
              "in that line's container and colours, or `tail`, in plain",
              "text at the right end of the footer line."]
    },
    "hint-tuck": {
      "type": "bool",
      "ports": ["mod"],
      "file": true,
      "flag": null,
      "doc-table": null,
      "doc": ["Draw the rows under the footer line with a bottom margin of",
              "-1, taking up the blank row Claude Code leaves between the",
              "footer and the agent panel's `* main`."]
    },
    "hint-inset": {
      "type": "int",
      "minimum": 0,
      "ports": ["mod"],
      "file": true,
      "flag": null,
      "doc-table": null,
      "doc": ["How many columns in from the terminal's left edge Claude Code",
              "draws the footer line's container, which the rows under it",
              "are drawn that much narrower to stack on the agent panel's."]
    },
    // A debugging aid.
    "footer-ruler": {
      "type": "bool",
      "ports": ["mod"],
      "file": true,
      "flag": null,
      "doc-table": null,
      "doc": ["A debugging aid: draw the footer's tail as a ruler of column",
              "digits, each the last digit of the column the mod reckons it",
              "lands in."]
    },
    "agent-message-row": {
      "type": "bool",
      "ports": ["mod"],
      "file": true,
      "flag": null,
      "doc-table": null,
      "doc": ["Draw the folded row of a message another agent sent as the",
              "sending agent's task and the message's first line,",
              "`› 🤖📨 <task>: <line>…`, instead of Claude Code's own row."]
    },
    "slow-toast": {
      "type": "bool",
      "ports": ["mod"],
      "file": true,
      "flag": null,
      "doc-table": null,
      "doc": ["Show a slow read as a toast as well as in the mod's log."]
    },
    // A store size, not a timing.
    "starts-kept": {
      "type": "int",
      "minimum": 1,
      "ports": ["mod"],
      "file": true,
      "flag": null,
      "doc-table": null,
      "doc": ["How many start lines the mod's store keeps, and as many keys",
              "of receipts stamped, newest first."]
    }
  }
}
