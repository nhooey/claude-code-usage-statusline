// The files both ports keep in the state directory: one row per kind of
// cache, naming its file and the format it is written in.
//
// tools/gen-spec.py writes this out as coding_agent_usage_line/state_spec.py
// and as mod/src/state_spec.ts, as it writes spec/layout.jsonc.  Edit here,
// never there, and run `python3 tools/gen-spec.py`; tests/formatting.py
// fails while either is out of date.
//
// A kind's file is <prefix><sha256(format\0key...)><suffix> in the state
// directory, named by state.state_path in the Python and statePath in the
// mod.  "key" names the parts the digest takes after the format.  Neither
// port's version is in it, so the two ports name one file and read each
// other's.  Bump a kind's format whenever what is written in it changes, in
// either port: the files written before then go by names nobody asks for.
//
// Every suffix is .cache, never .json: state.find_compatible reads .json
// files as usage caches.  The kinds still to come under this table are in
// agents/plans/saved-running-totals.md: the main fold, the agent fold and
// the window costs.
{
  "STATE_KINDS": {
    // The calibration scan: the costs in each plan window, the plan reading
    // taken with them and the windows they were measured over.  One file
    // per scope, which a reset overwrites: the source, the account's
    // hashed id (or, where the source names none, the reading caches'
    // namespace) and the period, joined by NULs (seed_limits_snapshot), so
    // every session of one account shares it.  A file untouched for eight
    // days is swept (_sweep_calibrations, sweepCalibrationsVia).
    "calibration": {
      "prefix": "claude-calibration-",
      "key": ["scope"],
      "suffix": ".cache",
      "format": 1
    },
    // The main transcript's two folds, the status line's and the turns',
    // saved as running totals so a reload reads on from where they stopped
    // (main_fold.py and main_fold.ts).  One directory per transcript path:
    // a log of what never changes once written, in part-N.cache files of
    // at most part_bytes of UTF-8 each, and the rest in a head, written
    // last, to head-a.cache and head-b.cache in turn, since $.fs.write
    // truncates and then writes and a reader can see the file torn.  A head
    // names the byte offset folded to, and the sha256 of the transcript's
    // first check_bytes and of the check_bytes before that offset.  Bump
    // the format whenever either fold, or what is saved of it, changes:
    // tests/fixtures/state/ fails until then.
    "main-fold": {
      "prefix": "claude-main-fold-",
      "key": ["transcript"],
      "suffix": "",
      "format": 1,
      "part_bytes": 1000000,
      "check_bytes": 4096
    }
  }
}
